    <!-- ========== ABOUT ========== -->
    <section id="about" class="section">
      <div class="container about-grid">

        <div class="reveal">
          <h2 class="section-title">I like turning data into software people can use.</h2>
          <p>
            I'm an aspiring Software and AI Engineer. I work in Python, Data Structures and
            Algorithms and OOP. I build machine learning apps with Scikit-learn and backend
            services with FastAPI and REST APIs.
          </p>
          <p>
            I'm comfortable with the full path: cleaning data, feature engineering, evaluating
            a model, wrapping it in an API and deploying it. I'm also learning Gen AI and RAG
            pipelines, and I use AI-assisted development tools to move faster.
          </p>

          <!-- Stats: all of these are real numbers from my CV -->
          <ul class="stats">
            <li><strong data-count="3">0</strong><span>Projects built</span></li>
            <li><strong data-count="3">0</strong><span>Gen AI certificates</span></li>
            <li><strong data-count="8.82" data-decimals="2">0</strong><span>CGPA so far</span></li>
            <li><strong data-count="1">0</strong><span>ML app live</span></li>
          </ul>
        </div>

        <!-- Code-style profile card -->
        <div class="code-card reveal tilt">
          <div class="code-top">
            <span></span><span></span><span></span>
            <p>aman.py</p>
          </div>
<pre><code><span class="c-kw">class</span> <span class="c-cls">Aman</span>:
    role     = <span class="c-str">"AI / Software Engineer"</span>
    degree   = <span class="c-str">"BCA, AI &amp; ML"</span>
    college  = <span class="c-str">"Sharda University, Agra"</span>

    languages = [<span class="c-str">"Python"</span>, <span class="c-str">"SQL"</span>, <span class="c-str">"Java"</span>, <span class="c-str">"JavaScript"</span>]
    ml_stack  = [<span class="c-str">"Scikit-learn"</span>, <span class="c-str">"PyTorch"</span>,
                 <span class="c-str">"TensorFlow"</span>, <span class="c-str">"Hugging Face"</span>]
    backend   = [<span class="c-str">"FastAPI"</span>, <span class="c-str">"Flask"</span>, <span class="c-str">"REST APIs"</span>]

    shipped   = <span class="c-str">"Mind Metrics (live on Render)"</span>

    <span class="c-kw">def</span> <span class="c-fn">open_to</span>(self):
        <span class="c-kw">return</span> <span class="c-str">"AI / Software Engineer roles"</span></code></pre>
        </div>

      </div>
