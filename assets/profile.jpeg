    <!-- ========== PROJECTS ========== -->
    <section id="projects" class="section">
      <div class="container">
        <h2 class="section-title reveal">Projects</h2>

        <!-- Featured: Mind Metrics with a live demo window -->
        <article class="featured reveal">

          <div class="featured-info">
            <p class="tag">Featured · Live on Render · 2026</p>
            <h3>Mind Metrics</h3>
            <p class="featured-sub">Mental health score prediction with machine learning.</p>
            <p>
              An end-to-end ML pipeline that takes a user's daily habits and predicts a
              mental health score out of 10. I did the data preprocessing, EDA, feature
              engineering and model evaluation, then built a FastAPI backend that serves
              the model through REST APIs for real-time predictions.
            </p>

            <!-- A real sequence, so numbered -->
            <ol class="pipeline">
              <li>Clean data</li>
              <li>EDA</li>
              <li>Feature engineering</li>
              <li>Train and evaluate</li>
              <li>FastAPI + REST</li>
              <li>Deploy on Render</li>
            </ol>

            <ul class="chips">
              <li>Python</li><li>Scikit-learn</li><li>Matplotlib</li><li>Seaborn</li>
              <li>FastAPI</li><li>REST APIs</li><li>Git &amp; GitHub</li><li>Render</li>
            </ul>

            <div class="hero-buttons">
              <a class="btn btn-primary" href="https://mental-health-score-ml-model-1.onrender.com/" target="_blank" rel="noopener noreferrer">Open live app</a>
              <a class="btn btn-outline" href="https://github.com/AmanBhushanOfficial" target="_blank" rel="noopener noreferrer">View code</a>
            </div>
          </div>

          <!-- Browser window mockup -->
          <div class="browser">
            <div class="browser-bar">
              <span></span><span></span><span></span>
              <p>mental-health-score-ml-model-1.onrender.com</p>
            </div>

            <div class="browser-screen" id="demoScreen">
              <img src="assets/mind-1.jpg" alt="Mind Metrics app showing a predicted score of 7.86 out of 10" id="demoImage">
            </div>

            <div class="browser-controls">
              <button class="mini-tab active" data-shot="assets/mind-1.jpg">Preview 1</button>
              <button class="mini-tab" data-shot="assets/mind-2.jpg">Preview 2</button>
              <button class="mini-tab mini-live" id="loadLive">Try it live here</button>
            </div>
            <p class="browser-note" id="demoNote">The live app runs on free hosting, so the first load can take a few seconds.</p>
          </div>
        </article>

        <!-- Two smaller projects -->
        <div class="project-pair">
          <article class="project tilt reveal">
            <div class="project-head">
              <h3>Cafe Management System</h3>
              <span>2026</span>
            </div>
            <p class="project-sub">Python · OOP · SQLite</p>
            <ul class="bullets">
              <li>Console app for menu management, customer orders and billing.</li>
              <li>CRUD operations backed by SQL and SQLite.</li>
              <li>Classes, encapsulation and modular code for reusable components.</li>
              <li>Exception handling so invalid input never crashes the app.</li>
            </ul>
            <ul class="chips">
              <li>Python</li><li>SQL</li><li>SQLite</li><li>OOP</li><li>File handling</li><li>Git</li>
            </ul>
          </article>

          <article class="project tilt reveal">
            <div class="project-head">
              <h3>Bank Management System</h3>
              <span>2025</span>
            </div>
            <p class="project-sub">Python · OOP · SQLite</p>
            <ul class="bullets">
              <li>Simulates account creation, deposits, withdrawals and balance checks.</li>
              <li>Transaction processing with customer records stored in SQL.</li>
              <li>Account validation and checks that block invalid operations.</li>
              <li>Structured with classes and methods for maintainable code.</li>
            </ul>
            <ul class="chips">
              <li>Python</li><li>SQL</li><li>SQLite</li><li>OOP</li><li>Data validation</li><li>Git</li>
            </ul>
          </article>
        </div>
      </div>
